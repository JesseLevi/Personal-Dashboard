# Copy to .env (git-ignored). Real values live outside git — hosted settings: docs/operations.md.
# NOTE: no NEXT_PUBLIC_ Supabase vars, ever — the browser never talks to Supabase (ADR-0033).

# Supabase (local dev values shown; server envs get their own)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=get-from-supabase-start-output
SUPABASE_SERVICE_ROLE_KEY=server-and-worker-only-never-in-app-code

# Hosted inference for recipe import (ADR-0018/0019, lib/ai/anthropic.ts). Server-only,
# also set in Vercel env. Unset = import runs degraded (no LLM). The spend cap lives in
# the Anthropic Console, not in code.
ANTHROPIC_API_KEY=

# Worker heartbeat ping (worker/index.ts skeleton) — optional, unused until a job runtime exists
HEALTHCHECKS_PING_URL=

# Figma token sync (ADR-0010) — only needed when running token/component syncs
FIGMA_API_KEY=

# Object storage on Cloudflare R2 (ADR-0024). Server-only, read only by lib/storage/,
# never NEXT_PUBLIC_. One bucket + one bucket-scoped Object Read & Write token per
# environment: development bucket for local and Vercel Preview, production bucket for
# Production. Also set in Vercel env (checklist: docs/operations.md -> Cloudflare R2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# e.g. R2_BUCKET_NAME=personal-dashboard-uploads-dev  (value only — never repeat the key)

# Cloudflare tooling (ADR-0024) — only needed for manual bucket/lifecycle management
# from a shell. The app never reads it.
CLOUDFLARE_API_TOKEN=

# Supabase Cloud CLI auth (ADR-0012) — only needed for the manual CLI
# remediation route (`supabase link` + `pnpm db:push` run by a human from a
# shell). The app itself never reads these. CI mirrors the same three
# values as GitHub Environment secrets (`supabase-production`), never as
# repo-wide secrets and never committed here with real values.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
