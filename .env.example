# Copy to .env (git-ignored). Real values live outside git — see Architecture §7.
# NOTE: no NEXT_PUBLIC_ Supabase vars, ever — the browser never talks to Supabase (ADR-0003).

# Supabase (local dev values shown; server envs get their own)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=get-from-supabase-start-output
SUPABASE_SERVICE_ROLE_KEY=server-and-worker-only-never-in-app-code

# Ollama — optional, local experiments only; never required (ADR-0018 §6)
OLLAMA_URL=http://127.0.0.1:11434

# Hosted inference for recipe import (ADR-0018/0019, lib/ai/anthropic.ts). Server-only,
# also set in Vercel env. Unset = import runs degraded (no LLM). The spend cap lives in
# the Anthropic Console, not in code.
ANTHROPIC_API_KEY=

# Observability dead-man's-switch (Architecture §7) — optional in dev
HEALTHCHECKS_PING_URL=

# Figma token sync (ADR-0010) — only needed when running token/component syncs
FIGMA_API_KEY=

# Object storage on Cloudflare R2 (ADR-0024). Server-only, read only by lib/storage/,
# never NEXT_PUBLIC_. One bucket + one bucket-scoped Object Read & Write token per
# environment: development bucket for local and Vercel Preview, production bucket for
# Production. Also set in Vercel env (checklist: docs/phase-log.md -> R2 setup).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# e.g. R2_BUCKET_NAME=personal-dashboard-uploads-dev  (value only — never repeat the key)

# Cloudflare tooling (ADR-0024) — only needed for manual bucket/lifecycle management
# from a shell. The app never reads it.
CLOUDFLARE_API_TOKEN=

# Supabase Cloud CLI auth (ADR-0012) — only needed for the manual CLI
# remediation route (`supabase link` + `pnpm db:push` run by a human from a
# shell). The app itself never reads these. CI mirrors the same three
# values as GitHub Environment secrets (`supabase-production`), never as
# repo-wide secrets and never committed here with real values.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=

# Login greeting (ADR-0031, lib/auth/greeting-lookup.ts). Server-only, also set in Vercel
# env (production values live there). Unset = fail closed: the login shows the generic
# greeting and the lookup RPC is never called.
# TURNSTILE_SITE_KEY is read server-side and passed to the client as a prop — never
# NEXT_PUBLIC_. Local/CI use Cloudflare's always-pass test keys below; no real keys in git.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Random string mixed into the hashed client key. Min 16 chars (shorter fails closed);
# in production use a random value of >= 32 chars (`openssl rand -hex 32`).
LOGIN_GREETING_SALT=local-dev-salt-0123456789abcdef
# Comma-separated hostnames Siteverify may report (e.g. `atlas.example.com`). When unset,
# the request host is used. Production: set it. The Cloudflare widget itself must be
# invisible/non-interactive and have its own hostname allowlist in the Cloudflare dashboard.
# The always-pass test secret above is ignored when VERCEL_ENV=production.
# TURNSTILE_ALLOWED_HOSTNAMES=
