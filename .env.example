# Copy to .env (git-ignored). Real values live outside git — see Architecture §7.
# NOTE: no NEXT_PUBLIC_ Supabase vars, ever — the browser never talks to Supabase (ADR-0003).

# Supabase (local dev values shown; server envs get their own)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=get-from-supabase-start-output
SUPABASE_SERVICE_ROLE_KEY=server-and-worker-only-never-in-app-code

# Ollama (ADR-0006)
OLLAMA_URL=http://127.0.0.1:11434

# Observability dead-man's-switch (Architecture §7) — optional in dev
HEALTHCHECKS_PING_URL=

# Figma token sync (ADR-0010) — only needed when running token/component syncs
FIGMA_API_KEY=
