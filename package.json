{
  "name": "personal-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:tokens": "node scripts/generate-theme.mjs",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "worker": "tsx worker/index.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public,reference > lib/database.types.ts",
    "test:rls": "supabase test db",
    "check:rls-coverage": "bash scripts/check-rls-coverage.sh",
    "check:server-only": "bash scripts/check-server-only.sh",
    "check:raw-spacing": "bash scripts/check-raw-spacing.sh",
    "check:comment-budget": "bash scripts/check-comment-budget.sh",
    "check:doc-budget": "bash scripts/check-doc-budget.sh",
    "check:tokens-drift": "node scripts/check-tokens-drift.mjs",
    "check:retired-tokens": "node scripts/check-retired-tokens.mjs"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tiptap/extension-highlight": "^3.30.0",
    "@tiptap/extension-subscript": "^3.30.0",
    "@tiptap/extension-superscript": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/extensions": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "^15.4.0",
    "next-intl": "^4.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@ladle/react": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.4.0",
    "postcss": "^8.5.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
